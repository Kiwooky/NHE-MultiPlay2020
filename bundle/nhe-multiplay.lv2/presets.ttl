@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix pset:  <http://lv2plug.in/ns/ext/presets#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

# Factory presets by Niels (New Horizon Electronics), made on the Duo with the
# cookbook prototype. Footswitch states (Repeat Hold, Slam, Effect) are left
# out on purpose, so loading a preset never freezes or slams the delay.

<https://github.com/Kiwooky/NHE-MultiPlay2020#preset-Choro_trem>
    a pset:Preset ;
    lv2:appliesTo <https://github.com/Kiwooky/NHE-MultiPlay2020> ;
    rdfs:label "Choro-trem" ;
    lv2:port [
        lv2:symbol "delay_time" ;
        pset:value 7.03125
    ] , [
        lv2:symbol "width" ;
        pset:value 10.0
    ] , [
        lv2:symbol "speed" ;
        pset:value 8.549107
    ] , [
        lv2:symbol "regen" ;
        pset:value 3.125
    ] , [
        lv2:symbol "mix" ;
        pset:value 7.03125
    ] , [
        lv2:symbol "range" ;
        pset:value 0
    ] , [
        lv2:symbol "slam_level" ;
        pset:value 5.133929
    ] , [
        lv2:symbol "time_mod" ;
        pset:value 1
    ] , [
        lv2:symbol "ramp_time" ;
        pset:value 0.45
    ] .

